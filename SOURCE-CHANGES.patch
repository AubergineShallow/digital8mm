+root=Path(a.cad_root).resolve(); out=Path(a.out).resolve(); out.mkdir(parents=True, exist_ok=True)
+built=Path(a.build_out).resolve() if a.build_out else root/'out'
+sys.path.insert(0,str(root))
+import cadquery as cq
+import layout as L
+import cots
