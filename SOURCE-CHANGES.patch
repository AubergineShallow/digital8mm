+            result = A.audit(Path(td), Path(td), require_step=True, final_release=True)
+        self.assertEqual(result['status'], 'fail')
+        self.assertTrue(result['failures'])
+
+
+if __name__ == '__main__':
+    unittest.main(verbosity=2)
