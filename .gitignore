# Local environments, tool caches and Python byproducts
/.venv*/
/.tools/
**/__pycache__/
*.py[cod]
*.egg-info/
**/build/
**/dist/

# CAD runtime state and logs
cad/gs8-d2-v1/.cad.lock
*.log

# Bulky or regenerable local material (git history replaces the baseline zips)
*.zip
*.npz
cad/gs8-d2-v1/candidate-fr1/out/
cad/gs8-d2-v1/out/_*/
!cad/gs8-d2-v1/out/_fujinon-cloud-polish-20261007/

# Manufacturer drawings and datasheet page images used during research stay local (third-party copyright)
cad/gs8-d2-v1/research/m12-drawings/
cad/gs8-d2-v1/research/r5-lens-support/*.png

# guide mesh cache (rebuilt by guide/build_guide.py --remesh)
cad/gs8-d2-v1/guide/_cache/
